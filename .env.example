# --- Local Supabase (default when you run `supabase start`) ---
# The importer and the /listings page read from this Postgres connection.
# Local Supabase exposes Postgres on port 54322 with these default creds.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Admin panel (BUILD_PROMPT §4) ---
# Shared key gating /admin and the moderation API. Set to any secret; access /admin?key=<value>.
# Lightweight gate until real Supabase-Auth admin roles land.
ADMIN_KEY=change-me

# --- Supabase Auth (BUILD_PROMPT §1) ---
# Passwordless magic-link sign-in + profile persistence. URL + anon key are public (client);
# the service role key is server-only (never expose it). Get them from the Supabase dashboard
# (Settings → API) or `supabase status` for local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key — server only>

# If DATABASE_URL is unset, the /listings page falls back to the static
# public/data/listings.generated.json produced by `npm run data:build`.
