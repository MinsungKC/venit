{
  "name": "oppmatch",
  "version": "0.1.0",
  "private": true,
  "description": "OppMatch — matching high-school students to companies, programs, and opportunities. Niche-companies database seeded from yc-oss.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:build": "tsx scripts/build-listings-json.ts",
    "data:enrich": "tsx scripts/enrich-sp500.ts",
    "data:gen": "tsx scripts/generate-university-labs.ts",
    "data:classify": "tsx scripts/classify.ts",
    "data:personality": "tsx scripts/embed-archetypes.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:studio": "node -e \"console.log('Supabase Studio: http://127.0.0.1:54323')\"",
    "db:import": "tsx scripts/import-listings.ts",
    "db:seed": "supabase db reset --no-seed && tsx scripts/import-listings.ts"
  },
  "dependencies": {
    "next": "14.2.15",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "supabase": "^2.110.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
